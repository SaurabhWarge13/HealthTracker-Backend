{
  "name": "health-tracker-backend",
  "version": "1.0.0",
  "description": "Mock REST backend for the health-tracker React Native app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --files src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "prisma:migrate": "prisma migrate dev",

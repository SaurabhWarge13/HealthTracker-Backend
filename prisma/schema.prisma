datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  refreshTokenHash String?
  createdAt        DateTime  @default(now())

  profile          Profile?
  checkIns         CheckIn[]
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])

  name           String?
  baselineWeight Float
  height         Float?
  stepGoal       Int?
  waterGoal      Int?
  /// Minutes, matching `sleepMinutes` on a check-in so neither side converts.
  sleepGoal      Int?
  targetWeight   Float?

  updatedAt      DateTime @updatedAt
}

model CheckIn {
  /// Canonical id, generated by the client when the check-in is made — possibly
  /// offline — and sent on create. The default applies only when none is given,
  /// which keeps server-assigned ids working for seeds and other API callers.
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  weightKg     Float
  heightCm     Float?
  sleepMinutes Int?
  steps        Int?
  waterMl      Int?
  mood         Int?
  notes        String?
  sourcesJson  String

  recordedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Not redundant with the primary key: it gives `upsert` a userId-scoped
  /// target. Upserting on the bare id would let a client that guessed another
  /// account's id overwrite that row.
  @@unique([userId, id])
  @@index([userId, recordedAt])
}

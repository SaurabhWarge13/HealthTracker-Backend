                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('code = NO_PENDING_SIGNUP', () => pm.expect(pm.response.json().error.code).to.eql('NO_PENDING_SIGNUP'));"
                ]

        {
          "name": "Another user's check-in (404, not 403)",
          "description": "Uses the second user's token against a check-in that genuinely belongs to the demo user. Returns the same 404 as a nonexistent record — the API never confirms that someone else's row exists.\n\nSelf-contained: the pre-request script creates a real check-in as the demo user first, so this proves scoping rather than just hitting a missing id.",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{altAccessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/checkins/{{crossUserCheckInId}}",
              "host": ["{{baseUrl}}"],
              "path": ["checkins", "{{crossUserCheckInId}}"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Create a check-in owned by the DEMO user, so the 404 below proves",
                  "// ownership scoping rather than the row simply not existing.",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/checkins',",
                  "  method: 'POST',",
                  "  header: {",
                  "    'Content-Type': 'application/json',",
                  "    'Authorization': 'Bearer ' + pm.collectionVariables.get('accessToken')",
                  "  },",
                  "  body: {",
                  "    mode: 'raw',",
                  "    raw: JSON.stringify({",
                  "      weightKg: 70.1,",
                  "      notes: 'owned by demo user',",
                  "      sources: { weight: 'manual', height: 'manual', sleep: 'manual', steps: 'manual', water: 'manual' },",
                  "      recordedAt: new Date().toISOString()",
                  "    })",
                  "  }",
                  "}, (err, res) => {",
                  "  if (!err && res.code === 201) {",
                  "    pm.collectionVariables.set('crossUserCheckInId', res.json().id);",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found (no existence leak)', () => pm.response.to.have.status(404));",
                  "pm.test('code = NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));",
                  "",
                  "// And confirm the row really does exist for its owner.",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/checkins/' + pm.collectionVariables.get('crossUserCheckInId'),",
                  "  method: 'GET',",
                  "  header: { 'Authorization': 'Bearer ' + pm.collectionVariables.get('accessToken') }",
                  "}, (err, res) => {",
                  "  pm.test('same row IS visible to its owner (200)', () => {",
                  "    pm.expect(res.code).to.eql(200);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]

            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('code = EMAIL_TAKEN', () => pm.expect(pm.response.json().error.code).to.eql('EMAIL_TAKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Signup — invalid body (400)",
          "description": "Shows the `fields` key: the full Zod issue tree, for mapping errors onto form inputs.",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const e = pm.response.json().error;",
                  "pm.test('code = VALIDATION_ERROR with a fields tree', () => {",
                  "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(e.message).to.be.a('string').and.not.empty;",
                  "  pm.expect(e).to.have.property('fields');",
                  "});"
                ]
              }
            }
          ]
        },
        {
